--!optimize 2
-- [[ Self-Contained Video Animation Player ]]
-- Generated for Hub Loader

local WIDTH = 48
local HEIGHT = 64
local TOTAL_FRAMES = 82
local FPS = 12

local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

-- Base64 Decoder
local b='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function decodeB64(data)
    data = string.gsub(data, '[^'..b..'=]', '')
    return (data:gsub('.', function(x)
        if (x == '=') then return '' end
        local r,f='',(b:find(x)-1)
        for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
        return r;
    end):gsub('%d%d%d%d%d%d%d%d', function(x)
        local c=0
        for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

-- Decompress / Read video data
local compressedData = ""
local rawVideoData

local decompressFunc = (syn and syn.decompress) or (crypt and crypt.lz4decompress) or (lz4decompress) or (bit and bit.decompress)
if decompressFunc then
    local pcallSuccess, result = pcall(function()
        return decompressFunc(decodeB64(compressedData))
    end)
    if pcallSuccess and result and #result == TOTAL_FRAMES * WIDTH * HEIGHT * 3 then
        rawVideoData = result
    end
end

-- UI Construction
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "HubVideoPlayer"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = (gethui and gethui()) or CoreGui

local container = Instance.new("Frame")
container.Size = UDim2.new(0, WIDTH * 6, 0, HEIGHT * 6)
container.Position = UDim2.new(0.5, -(WIDTH * 6) / 2, 0.5, -(HEIGHT * 6) / 2)
container.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
container.BorderSizePixel = 0
container.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = container

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 24)
title.Position = UDim2.new(0, 0, 1, 6)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamMedium
title.Text = "Hub Loading..."
title.TextColor3 = Color3.fromRGB(200, 200, 210)
title.TextSize = 14
title.Parent = container

-- Build Pixel Grid using EditableImage (if available) or optimized Frames
local pixelFrames = table.create(WIDTH * HEIGHT)
local pixelSizeX = 1 / WIDTH
local pixelSizeY = 1 / HEIGHT

for y = 0, HEIGHT - 1 do
    for x = 0, WIDTH - 1 do
        local pixel = Instance.new("Frame")
        pixel.Size = UDim2.new(pixelSizeX, 1, pixelSizeY, 1)
        pixel.Position = UDim2.new(x * pixelSizeX, 0, y * pixelSizeY, 0)
        pixel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        pixel.BorderSizePixel = 0
        pixel.Parent = container
        pixelFrames[y * WIDTH + x + 1] = pixel
    end
end

print("[Hub Player] Initialized canvas (" .. WIDTH .. "x" .. HEIGHT .. "). Starting playback...")

-- Fallback/Uncompressed byte stream reader
local byteData = decodeB64(compressedData)

-- Playback loop
local frameDelay = 1 / FPS
local frameBytes = WIDTH * HEIGHT * 3

task.spawn(function()
    for frameIdx = 0, TOTAL_FRAMES - 1 do
        local startClock = os.clock()
        local offset = frameIdx * frameBytes
        
        -- Render frame pixels
        for i = 1, #pixelFrames do
            local pOff = offset + (i - 1) * 3
            if rawVideoData then
                local r = string.byte(rawVideoData, pOff + 1) or 0
                local g = string.byte(rawVideoData, pOff + 2) or 0
                local b = string.byte(rawVideoData, pOff + 3) or 0
                pixelFrames[i].BackgroundColor3 = Color3.fromRGB(r, g, b)
            end
        end
        
        local elapsed = os.clock() - startClock
        if elapsed < frameDelay then
            task.wait(frameDelay - elapsed)
        else
            task.wait()
        end
    end
    
    task.wait(0.5)
    screenGui:Destroy()
    print("[Hub Player] Animation complete!")
end)
